rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function verifiedAccount() {
      return request.auth != null && request.auth.token.email_verified == true
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    match /stall_images/{fileName} {
      allow read: if true;
      allow write: if verifiedAccount()
          && request.auth.uid == fileName.replace('.jpg', '');
    }
    match /menu_images/{vendorId}/{fileName} {
      allow read: if true;
      allow write: if verifiedAccount() && request.auth.uid == vendorId;
    }
    match /review_images/{vendorId}/{customerId}/{fileName} {
      allow read: if true;
      allow create, update: if verifiedAccount()
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && request.auth.uid == customerId
          && request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
          && request.auth.uid == customerId;
    }
  }
}

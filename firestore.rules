rules_version = '2';

// Dish subscriptions: users/{customerId}/dishFollows/{vendorId}:{itemId}.
// Fields: customerId, vendorId, itemId (immutable strings, max 128 characters)
// and followedAt (immutable server timestamp). Only verified customers can
// manage their subscriptions; dish availability and notification content are
// server-managed. No subscription data is public.
// Saved pins: users/{customerId}/savedLocations/{locationId}, with name
// (1..60 chars), address (1..500 chars), latitude/longitude (valid coordinates),
// isHome (bool; true only at the single 'home' ID), updatedAt (server timestamp).

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function ownsVendor(vendorId) {
      return verifiedAccount()
          && request.auth.uid == vendorId
          && getAfter(/databases/$(database)/documents/users/$(vendorId))
              .data.role == 'vendor';
    }

    function verifiedAccount() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function initialVendorRecord(vendorId) {
      return signedIn() && request.auth.uid == vendorId
          && getAfter(/databases/$(database)/documents/users/$(vendorId)).data.role == 'vendor'
          && request.resource.data.keys().hasOnly(['vendorId', 'phoneNumber', 'isOpen'])
          && request.resource.data.vendorId == vendorId
          && request.resource.data.phoneNumber is string
          && request.resource.data.phoneNumber.size() <= 20
          && request.resource.data.isOpen == false;
    }

    function validReviewPhotoUrls(urls) {
      return urls is list && urls.size() <= 5
          && (urls.size() < 1 || (urls[0] is string && urls[0].size() <= 2048))
          && (urls.size() < 2 || (urls[1] is string && urls[1].size() <= 2048))
          && (urls.size() < 3 || (urls[2] is string && urls[2].size() <= 2048))
          && (urls.size() < 4 || (urls[3] is string && urls[3].size() <= 2048))
          && (urls.size() < 5 || (urls[4] is string && urls[4].size() <= 2048));
    }

    function validSearchHistory(data) {
      return data.keys().hasOnly([
              'query', 'normalizedQuery', 'searchedAt'
            ])
          && data.keys().hasAll([
              'query', 'normalizedQuery', 'searchedAt'
            ])
          && data.query is string
          && data.query.size() > 0
          && data.query.size() <= 100
          && data.normalizedQuery is string
          && data.normalizedQuery.size() > 0
          && data.normalizedQuery.size() <= 100
          && data.normalizedQuery == data.query.lower()
          && data.searchedAt == request.time;
    }

    function ownsCustomer(userId) {
      return verifiedAccount() && request.auth.uid == userId
          && get(/databases/$(database)/documents/users/$(userId)).data.role == 'customer';
    }

    function validDishFollow(data, userId, followId) {
      return data.keys().hasOnly(['customerId', 'vendorId', 'itemId', 'followedAt'])
          && data.keys().hasAll(['customerId', 'vendorId', 'itemId', 'followedAt'])
          && data.customerId is string && data.customerId.size() <= 128
          && data.customerId == userId
          && data.vendorId is string && data.vendorId.size() > 0
          && data.vendorId.size() <= 128 && data.vendorId.matches('^[^/:]+$')
          && data.itemId is string && data.itemId.size() > 0
          && data.itemId.size() <= 128 && data.itemId.matches('^[^/:]+$')
          && followId == data.vendorId + ':' + data.itemId
          && data.followedAt is timestamp;
    }

    function validSavedLocation(data, locationId) {
      return data.keys().hasOnly(['name', 'address', 'latitude', 'longitude', 'isHome', 'updatedAt'])
          && data.keys().hasAll(['name', 'address', 'latitude', 'longitude', 'isHome', 'updatedAt'])
          && data.name is string && data.name.size() > 0 && data.name.size() <= 60
          && data.address is string && data.address.size() > 0 && data.address.size() <= 500
          && data.latitude is number && data.latitude >= -90 && data.latitude <= 90
          && data.longitude is number && data.longitude >= -180 && data.longitude <= 180
          && data.isHome is bool && data.isHome == (locationId == 'home')
          && (!data.isHome || data.name == 'Home')
          && data.updatedAt == request.time;
    }

    match /_connection_test_/{docId} {
      allow read, write: if true;
    }

    match /reports/{reportId} {
      allow read, write: if true;
    }

    match /stalls/{stallId} {
      allow read, write: if true;
    }

    match /vendors/{vendorId} {
      allow read: if true;
      allow create: if initialVendorRecord(vendorId) || (ownsVendor(vendorId)
          && request.resource.data.vendorId == vendorId);
      allow update: if ownsVendor(vendorId)
          && request.resource.data.vendorId == vendorId
          && request.resource.data.get('selfCollectEnabled', false) is bool;
      allow delete: if false;

      match /menu/{itemId} {
        allow read: if true;
        allow create, update, delete: if ownsVendor(vendorId);
      }
    }

    // Firestore collection-group queries need an explicit recursive match.
    // Menu data is already public at its direct vendor path and contains no
    // customer or account data.
    match /{path=**}/menu/{itemId} {
      allow read: if true;
    }

    // Booking creation, status changes and seen flags are server controlled.
    // Queries must restrict either customerId or vendorId to the signed-in UID.
    match /bookings/{bookingId} {
      allow get, list: if verifiedAccount()
          && (resource.data.customerId == request.auth.uid
              || resource.data.vendorId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /stallReviews/{vendorId}/entries/{customerId} {
        allow read: if true;
        allow create, update: if verifiedAccount()
            && request.auth.uid == customerId
            && customerId != vendorId
            && get(/databases/$(database)/documents/users/$(customerId)).data.role == 'customer'
            && request.resource.data.keys().hasOnly([
                'customerId', 'customerName', 'rating', 'text',
                'photoUrls', 'updatedAt'
              ])
            && request.resource.data.customerId == customerId
            && request.resource.data.customerName is string
            && request.resource.data.customerName.size() <= 80
            && request.resource.data.rating is int
            && request.resource.data.rating >= 1
            && request.resource.data.rating <= 5
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 1000
            && validReviewPhotoUrls(request.resource.data.photoUrls)
            && request.resource.data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if signedIn() && request.auth.uid == userId
          && request.resource.data.role in ['customer', 'vendor'];
      allow update: if signedIn() && request.auth.uid == userId
          && request.resource.data.role == resource.data.role;

      match /savedLocations/{locationId} {
        allow read, delete: if ownsCustomer(userId);
        allow create, update: if ownsCustomer(userId)
            && validSavedLocation(request.resource.data, locationId);
      }

      match /dishFollows/{followId} {
        // Owner path checks also permit a transaction to read a missing
        // subscription before its first follow, and permit owner list queries.
        allow read, delete: if ownsCustomer(userId);
        allow create: if ownsCustomer(userId)
            && validDishFollow(request.resource.data, userId, followId)
            && request.resource.data.followedAt == request.time
            && exists(/databases/$(database)/documents/vendors/$(request.resource.data.vendorId))
            && exists(/databases/$(database)/documents/vendors/$(request.resource.data.vendorId)/menu/$(request.resource.data.itemId));
        allow update: if ownsCustomer(userId)
            && validDishFollow(request.resource.data, userId, followId)
            && request.resource.data == resource.data;
      }

      match /notifications/{notificationId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow update: if signedIn() && request.auth.uid == userId
            && request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly(['isRead'])
            && request.resource.data.isRead == true;
        allow create, delete: if false;
      }

      match /searchHistory/{searchId} {
        allow read: if verifiedAccount() && request.auth.uid == userId;
        allow create, update: if verifiedAccount()
            && request.auth.uid == userId
            && validSearchHistory(request.resource.data);
        allow delete: if verifiedAccount() && request.auth.uid == userId;
      }
    }

    match /follows/{followId} {
      allow read: if request.auth != null
          && request.auth.uid == resource.data.customerId;
      allow create: if verifiedAccount()
          && request.auth.uid == request.resource.data.customerId;
      allow delete: if request.auth != null
          && request.auth.uid == resource.data.customerId;
    }
  }
}

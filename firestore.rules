rules_version = '2';

// Dish subscriptions: users/{customerId}/dishFollows/{vendorId}:{itemId}.
// Fields: customerId, vendorId, itemId (immutable strings, max 128 characters)
// and followedAt (immutable server timestamp). Only verified customers can
// manage their subscriptions; dish availability and notification content are
// server-managed. No subscription data is public.
// Saved pins: users/{customerId}/savedLocations/{locationId}, with name
// (1..60 chars), address (1..500 chars), latitude/longitude (valid coordinates),
// isHome (bool; true only at the single 'home' ID), updatedAt (server timestamp).
//
// Assumed Data Model (Vendor Payouts):
// Collection: vendorPayoutDetails
// Document ID: {vendorId} (matches owning vendor UID)
// Fields:
//   - vendorId: string (required, immutable, == vendorId)
//   - bankName: string (required, 2..80 chars, trimmed >= 2)
//   - accountHolderName: string (required, 2..120 chars, trimmed >= 2)
//   - accountNumber: string (required, 6..24 digits: ^[0-9]{6,24}$)
//   - duitNowId: string (optional, <= 64 chars)
//   - notes: string (optional, <= 200 chars)
//   - updatedAt: timestamp (required, == request.time)
//
// Collection: vendorPayouts
// Document ID: {payoutId} (auto-generated)
// Fields:
//   - vendorId: string (required, immutable, 1..128 chars)
//   - stallName: string (optional, immutable, <= 160 chars)
//   - amountCents: int (required, immutable, 100..50000000)
//   - status: string (required: 'pending' on vendor create, 'paid' on admin direct create, 'paid'|'rejected' on admin update from 'pending')
//   - bankName: string (required, immutable, 2..80 chars, trimmed >= 2)
//   - accountHolderName: string (required, immutable, 2..120 chars, trimmed >= 2)
//   - accountNumber: string (required, immutable, ^[0-9]{6,24}$)
//   - duitNowId: string (optional, immutable, <= 64 chars)
//   - vendorNote: string (optional, immutable, <= 240 chars)
//   - requestedBy: string (required, immutable, == caller UID on create)
//   - requestedAt: timestamp (required, immutable, == request.time on create)
//   - transferReference: string (admin settlement only; required 2..120 trimmed>=2 when paid; absent or '' when rejected)
//   - adminNote: string (admin settlement only; optional <= 240 when paid; required 2..240 trimmed>=2 when rejected)
//   - settledByUid: string (admin settlement only; required == admin UID)
//   - settledByEmail: string (admin settlement only; optional <= 254 chars)
//   - settledAt: timestamp (admin settlement only; required == request.time)
//   - updatedAt: timestamp (required, == request.time)

service cloud.firestore {
  match /databases/{database}/documents {
    // Preserve the production admin directory's bounded live-listener access.
    function directoryAdmin() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null
          && profile.get('role', profile.get('userRole', profile.get('type', ''))).lower() == 'admin';
    }

    match /adminDirectory/{entryId} {
      allow read: if request.auth != null && directoryAdmin();
      allow write: if false;
    }

    match /adminDirectoryCategories/{entryId} {
      allow read, write: if false;
    }

    match /adminDirectoryMeta/{entryId} {
      allow read, write: if false;
    }

    function signedIn() {
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && !exists(/databases/$(database)/documents/_accountDeletions/$(request.auth.uid));
    }

    function ownsVendor(vendorId) {
      return verifiedAccount()
          && request.auth.uid == vendorId
          && getAfter(/databases/$(database)/documents/users/$(vendorId))
              .data.role == 'vendor';
    }

    function verifiedAccount() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function initialVendorRecord(vendorId) {
      return signedIn() && request.auth.uid == vendorId
          && getAfter(/databases/$(database)/documents/users/$(vendorId)).data.role == 'vendor'
          && request.resource.data.keys().hasOnly(['vendorId', 'phoneNumber', 'isOpen'])
          && request.resource.data.vendorId == vendorId
          && request.resource.data.phoneNumber is string
          && request.resource.data.phoneNumber.size() <= 20
          && request.resource.data.isOpen == false;
    }

    function validReviewPhotoUrls(urls) {
      return urls is list && urls.size() <= 5
          && (urls.size() < 1 || (urls[0] is string && urls[0].size() <= 2048))
          && (urls.size() < 2 || (urls[1] is string && urls[1].size() <= 2048))
          && (urls.size() < 3 || (urls[2] is string && urls[2].size() <= 2048))
          && (urls.size() < 4 || (urls[3] is string && urls[3].size() <= 2048))
          && (urls.size() < 5 || (urls[4] is string && urls[4].size() <= 2048));
    }

    function validSearchHistory(data) {
      return data.keys().hasOnly([
              'query', 'normalizedQuery', 'searchedAt'
            ])
          && data.keys().hasAll([
              'query', 'normalizedQuery', 'searchedAt'
            ])
          && data.query is string
          && data.query.size() > 0
          && data.query.size() <= 100
          && data.normalizedQuery is string
          && data.normalizedQuery.size() > 0
          && data.normalizedQuery.size() <= 100
          && data.normalizedQuery == data.query.lower()
          && data.searchedAt == request.time;
    }

    function ownsCustomer(userId) {
      return verifiedAccount() && request.auth.uid == userId
          && get(/databases/$(database)/documents/users/$(userId)).data.role == 'customer';
    }

    function validSavedSearch(data) {
      let f = data.filters;
      return data.keys().hasOnly(['name', 'filters', 'savedAt'])
          && data.keys().hasAll(['name', 'filters', 'savedAt'])
          && data.name is string && data.name.size() > 0 && data.name.size() <= 80
          && data.savedAt == request.time
          && f is map
          && f.keys().hasOnly(['query', 'category', 'minimum', 'maximum',
              'radius', 'status', 'sort', 'availableOnly', 'selfCollectOnly',
              'recentOnly', 'listOnly', 'latitude', 'longitude',
              'openingStart', 'openingEnd', 'openingLabel'])
          && f.keys().hasAll(['query', 'category', 'minimum', 'maximum',
              'radius', 'status', 'sort', 'availableOnly', 'selfCollectOnly',
              'recentOnly', 'listOnly', 'latitude', 'longitude',
              'openingStart', 'openingEnd', 'openingLabel'])
          && f.query is string && f.query.size() <= 100
          && (f.category == null || (f.category is string && f.category.size() <= 80))
          && (f.minimum == null || (f.minimum is number && f.minimum >= 0 && f.minimum <= 100000))
          && (f.maximum == null || (f.maximum is number && f.maximum >= 0 && f.maximum <= 100000))
          && (f.minimum == null || f.maximum == null || f.minimum <= f.maximum)
          && f.radius in [5, 10, 25, 50]
          && f.status in ['Open', 'Closed', 'All']
          && f.sort in ['distance', 'price', 'rating', 'newest', 'updated']
          && f.availableOnly is bool && f.selfCollectOnly is bool
          && f.recentOnly is bool && f.listOnly is bool
          && ((f.latitude == null && f.longitude == null)
              || (f.latitude is number && f.latitude >= -90 && f.latitude <= 90
                  && f.longitude is number && f.longitude >= -180 && f.longitude <= 180))
          && ((f.openingStart == null && f.openingEnd == null && f.openingLabel == null)
              || (f.openingStart is int && f.openingStart >= 0
                  && (f.openingEnd == null || (f.openingEnd is int && f.openingEnd > f.openingStart))
                  && f.openingLabel is string && f.openingLabel.size() <= 100));
    }

    function validDishFollow(data, userId, followId) {
      return data.keys().hasOnly(['customerId', 'vendorId', 'itemId', 'followedAt'])
          && data.keys().hasAll(['customerId', 'vendorId', 'itemId', 'followedAt'])
          && data.customerId is string && data.customerId.size() <= 128
          && data.customerId == userId
          && data.vendorId is string && data.vendorId.size() > 0
          && data.vendorId.size() <= 128 && data.vendorId.matches('^[^/:]+$')
          && data.itemId is string && data.itemId.size() > 0
          && data.itemId.size() <= 128 && data.itemId.matches('^[^/:]+$')
          && followId == data.vendorId + ':' + data.itemId
          && data.followedAt is timestamp;
    }

    function validSavedLocation(data, locationId) {
      return data.keys().hasOnly(['name', 'address', 'latitude', 'longitude', 'isHome', 'updatedAt'])
          && data.keys().hasAll(['name', 'address', 'latitude', 'longitude', 'isHome', 'updatedAt'])
          && data.name is string && data.name.size() > 0 && data.name.size() <= 60
          && data.address is string && data.address.size() > 0 && data.address.size() <= 500
          && data.latitude is number && data.latitude >= -90 && data.latitude <= 90
          && data.longitude is number && data.longitude >= -180 && data.longitude <= 180
          && data.isHome is bool && data.isHome == (locationId == 'home')
          && (!data.isHome || data.name == 'Home')
          && data.updatedAt == request.time;
    }

    // Retired collections have no client-facing flows. Keep existing records
    // accessible only to trusted server/Admin SDK operations (including cleanup).
    match /_connection_test_/{docId} {
      allow read, write: if false;
    }

    match /reports/{reportId} {
      allow read, write: if false;
    }

    match /stalls/{stallId} {
      allow read, write: if false;
    }

    // Moderation: reports are private, cases contain only vendor-safe summaries.
    // Client writes are denied; authenticated callable functions validate them.
    match /vendorReports/{reportId} {
      allow read: if signedIn() && (directoryAdmin()
          || (verifiedAccount() && resource.data.customerId == request.auth.uid));
      allow write: if false;
    }
    match /moderationCases/{caseId} {
      allow read: if signedIn() && (directoryAdmin()
          || (verifiedAccount() && resource.data.vendorId == request.auth.uid));
      allow write: if false;
      match /responses/{responseId} {
        allow read: if signedIn() && (directoryAdmin()
            || (verifiedAccount() && get(/databases/$(database)/documents/moderationCases/$(caseId)).data.vendorId == request.auth.uid));
        allow write: if false;
      }
    }
    match /vendorModeration/{vendorId} {
      allow read: if signedIn() && (directoryAdmin() || (verifiedAccount() && request.auth.uid == vendorId));
      allow write: if false;
    }
    match /moderationRateLimits/{key} { allow read, write: if false; }

    function validVendorModeration(data) {
      return data.get('listingStatus', 'active') in ['active', 'suspended']
          && (data.get('listingStatus', 'active') != 'suspended'
              || (data.get('isOpen', false) == false
                  && data.get('locationSharingActive', false) == false));
    }

    match /vendors/{vendorId} {
      allow read: if true;
      allow create: if validVendorModeration(request.resource.data)
          && request.resource.data.get('listingStatus', 'active') == 'active'
          && (initialVendorRecord(vendorId) || (ownsVendor(vendorId)
              && request.resource.data.vendorId == vendorId));
      allow update: if ownsVendor(vendorId)
          && validVendorModeration(request.resource.data)
          && request.resource.data.get('listingStatus', 'active') == resource.data.get('listingStatus', 'active')
          && request.resource.data.vendorId == vendorId
          && request.resource.data.get('selfCollectEnabled', false) is bool;
      allow delete: if false;

      match /menu/{itemId} {
        allow read: if true;
        allow create, update, delete: if ownsVendor(vendorId);
      }
    }

    // Firestore collection-group queries need an explicit recursive match.
    // Menu data is already public at its direct vendor path and contains no
    // customer or account data.
    match /{path=**}/menu/{itemId} {
      allow read: if true;
    }

    // Booking creation, status changes and seen flags are server controlled.
    // Queries must restrict either customerId or vendorId to the signed-in UID.
    match /bookings/{bookingId} {
      allow get, list: if verifiedAccount()
          && (resource.data.customerId == request.auth.uid
              || resource.data.vendorId == request.auth.uid);
      allow create, update, delete: if false;
    }

    function validVendorPayoutDetails(data, vendorId) {
      return data.keys().hasOnly([
              'vendorId', 'bankName', 'accountHolderName', 'accountNumber',
              'duitNowId', 'notes', 'updatedAt'
            ])
          && data.keys().hasAll([
              'vendorId', 'bankName', 'accountHolderName', 'accountNumber',
              'updatedAt'
            ])
          && data.vendorId is string
          && data.vendorId == vendorId
          && data.bankName is string
          && data.bankName.size() >= 2
          && data.bankName.size() <= 80
          && data.bankName.trim().size() >= 2
          && data.accountHolderName is string
          && data.accountHolderName.size() >= 2
          && data.accountHolderName.size() <= 120
          && data.accountHolderName.trim().size() >= 2
          && data.accountNumber is string
          && data.accountNumber.matches('^[0-9]{6,24}$')
          && (!('duitNowId' in data)
              || (data.duitNowId is string && data.duitNowId.size() <= 64))
          && (!('notes' in data)
              || (data.notes is string && data.notes.size() <= 200))
          && data.updatedAt == request.time;
    }

    function validVendorPayoutBase(data) {
      return data.vendorId is string
          && data.vendorId.size() > 0
          && data.vendorId.size() <= 128
          && data.amountCents is int
          && data.amountCents >= 100
          && data.amountCents <= 50000000
          && data.bankName is string
          && data.bankName.size() >= 2
          && data.bankName.size() <= 80
          && data.bankName.trim().size() >= 2
          && data.accountHolderName is string
          && data.accountHolderName.size() >= 2
          && data.accountHolderName.size() <= 120
          && data.accountHolderName.trim().size() >= 2
          && data.accountNumber is string
          && data.accountNumber.matches('^[0-9]{6,24}$')
          && (!('stallName' in data)
              || (data.stallName is string && data.stallName.size() <= 160))
          && (!('duitNowId' in data)
              || (data.duitNowId is string && data.duitNowId.size() <= 64))
          && (!('vendorNote' in data)
              || (data.vendorNote is string && data.vendorNote.size() <= 240))
          && data.requestedBy is string
          && data.requestedBy.size() > 0
          && data.requestedBy.size() <= 128
          && data.requestedAt is timestamp
          && data.updatedAt == request.time;
    }

    function validVendorPayoutPendingCreate(data) {
      return data.keys().hasOnly([
              'vendorId', 'stallName', 'amountCents', 'status', 'bankName',
              'accountHolderName', 'accountNumber', 'duitNowId', 'vendorNote',
              'requestedBy', 'requestedAt', 'updatedAt'
            ])
          && data.keys().hasAll([
              'vendorId', 'amountCents', 'status', 'bankName',
              'accountHolderName', 'accountNumber', 'requestedBy',
              'requestedAt', 'updatedAt'
            ])
          && validVendorPayoutBase(data)
          && data.status == 'pending'
          && data.requestedBy == request.auth.uid
          && data.requestedAt == request.time;
    }

    function validVendorPayoutSettlementFields(data) {
      return data.keys().hasOnly([
              'vendorId', 'stallName', 'amountCents', 'status', 'bankName',
              'accountHolderName', 'accountNumber', 'duitNowId', 'vendorNote',
              'transferReference', 'adminNote', 'requestedBy', 'requestedAt',
              'settledByUid', 'settledByEmail', 'settledAt', 'updatedAt'
            ])
          && data.keys().hasAll([
              'vendorId', 'amountCents', 'status', 'bankName',
              'accountHolderName', 'accountNumber', 'requestedBy',
              'requestedAt', 'settledByUid', 'settledAt', 'updatedAt'
            ])
          && validVendorPayoutBase(data)
          && data.settledByUid == request.auth.uid
          && data.settledAt == request.time
          && (!('settledByEmail' in data)
              || (data.settledByEmail is string
                  && data.settledByEmail.size() <= 254))
          && (!('adminNote' in data)
              || (data.adminNote is string && data.adminNote.size() <= 240));
    }

    function validVendorPayoutDirectPaidCreate(data) {
      return validVendorPayoutSettlementFields(data)
          && data.status == 'paid'
          && data.requestedBy == request.auth.uid
          && data.requestedAt == request.time
          && 'transferReference' in data
          && data.transferReference is string
          && data.transferReference.size() >= 2
          && data.transferReference.size() <= 120
          && data.transferReference.trim().size() >= 2;
    }

    function validVendorPayoutAdminUpdate(data, existing) {
      return 'status' in existing
          && existing.status == 'pending'
          && data.diff(existing).affectedKeys().hasOnly([
              'status', 'transferReference', 'adminNote', 'settledByUid',
              'settledByEmail', 'settledAt', 'updatedAt'
            ])
          && validVendorPayoutSettlementFields(data)
          && ((data.status == 'paid'
                  && 'transferReference' in data
                  && data.transferReference is string
                  && data.transferReference.size() >= 2
                  && data.transferReference.size() <= 120
                  && data.transferReference.trim().size() >= 2)
              || (data.status == 'rejected'
                  && 'adminNote' in data
                  && data.adminNote is string
                  && data.adminNote.size() >= 2
                  && data.adminNote.size() <= 240
                  && data.adminNote.trim().size() >= 2
                  && (!('transferReference' in data)
                      || (data.transferReference is string
                          && data.transferReference.size() == 0))));
    }

    // Private vendor payout bank details (kept off public vendors/{vendorId}).
    match /vendorPayoutDetails/{vendorId} {
      allow get: if ownsVendor(vendorId) || (signedIn() && directoryAdmin());
      allow list: if signedIn() && directoryAdmin();
      allow create: if ownsVendor(vendorId)
          && validVendorPayoutDetails(request.resource.data, vendorId);
      allow update: if ownsVendor(vendorId)
          && 'vendorId' in resource.data
          && resource.data.vendorId == vendorId
          && validVendorPayoutDetails(request.resource.data, vendorId);
      allow delete: if false;
    }

    // Auditable vendor payout requests and admin settlement records.
    // Vendor list queries must filter by vendorId == request.auth.uid.
    match /vendorPayouts/{payoutId} {
      allow get, list: if signedIn() && (directoryAdmin()
          || (verifiedAccount()
              && resource.data.vendorId == request.auth.uid
              && get(/databases/$(database)/documents/users/$(request.auth.uid))
                  .data.role == 'vendor'));
      allow create: if ('vendorId' in request.resource.data
              && request.resource.data.vendorId is string
              && ownsVendor(request.resource.data.vendorId)
              && validVendorPayoutPendingCreate(request.resource.data))
          || (signedIn() && directoryAdmin()
              && validVendorPayoutDirectPaidCreate(request.resource.data));
      allow update: if signedIn() && directoryAdmin()
          && validVendorPayoutAdminUpdate(request.resource.data, resource.data);
      allow delete: if false;
    }

    // Public review snapshot. Exactly one optional owner reply lives in the
    // review document, so deleting the review also removes the public reply.
    function validStallReview(data, customerId) {
      return data.keys().hasOnly(['customerId', 'customerName', 'customerAvatarUrl',
              'rating', 'text', 'photoUrls', 'createdAt', 'updatedAt', 'edited', 'vendorReply'])
          && data.keys().hasAll(['customerId', 'customerName', 'rating', 'text', 'photoUrls', 'updatedAt'])
          && data.customerId == customerId
          && data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 80
          && data.rating is int && data.rating >= 1 && data.rating <= 5
          && data.text is string && data.text.size() <= 1000
          && validReviewPhotoUrls(data.photoUrls)
          && data.updatedAt is timestamp
          && (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time))
          && data.get('edited', false) is bool
          && data.get('customerAvatarUrl', '') is string
          && data.get('customerAvatarUrl', '').size() <= 2048
          && (data.get('customerAvatarUrl', '') == '' || data.customerAvatarUrl.matches('https://.*'));
    }

    function validOwnerReply(reply) {
      return reply is map
          && reply.keys().hasOnly(['text', 'createdAt', 'updatedAt', 'edited', 'reviewUpdatedAt'])
          && reply.keys().hasAll(['text', 'createdAt', 'updatedAt', 'edited', 'reviewUpdatedAt'])
          && reply.text is string && reply.text.size() > 0 && reply.text.size() <= 1000
          && reply.text.matches('[\\s\\S]*\\S[\\s\\S]*')
          && reply.createdAt is timestamp && reply.createdAt <= request.time
          && reply.updatedAt == request.time && reply.edited is bool
          && reply.reviewUpdatedAt is timestamp
          && reply.reviewUpdatedAt <= resource.data.updatedAt;
    }

    match /stallReviews/{vendorId}/entries/{customerId} {
      allow read: if true;
      allow create: if ownsCustomer(customerId) && customerId != vendorId
          && exists(/databases/$(database)/documents/vendors/$(vendorId))
          && validStallReview(request.resource.data, customerId)
          && !('vendorReply' in request.resource.data)
          && request.resource.data.updatedAt == request.time
          && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time)
          && request.resource.data.get('edited', false) == false;
      allow update: if (ownsCustomer(customerId) && customerId != vendorId
          && validStallReview(request.resource.data, customerId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'customerName', 'customerAvatarUrl', 'rating', 'text', 'photoUrls', 'createdAt', 'updatedAt', 'edited'])
          && request.resource.data.updatedAt == request.time
          && (('createdAt' in resource.data && request.resource.data.createdAt == resource.data.createdAt)
              || (!('createdAt' in resource.data) && (!('createdAt' in request.resource.data)
                  || request.resource.data.createdAt == resource.data.updatedAt)))
          && (!('edited' in resource.data) || request.resource.data.edited == true))
          || (ownsVendor(vendorId)
              && validStallReview(request.resource.data, customerId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vendorReply'])
              && ( !('vendorReply' in request.resource.data)
                  || (validOwnerReply(request.resource.data.vendorReply)
                      && (('vendorReply' in resource.data
                          && request.resource.data.vendorReply.createdAt == resource.data.vendorReply.createdAt
                          && request.resource.data.vendorReply.edited == true)
                        || (!('vendorReply' in resource.data)
                          && request.resource.data.vendorReply.createdAt == request.time
                          && request.resource.data.vendorReply.edited == false)))));
      allow delete: if ownsCustomer(customerId) && customerId != vendorId;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || directoryAdmin());
      allow create: if signedIn() && request.auth.uid == userId
          && request.resource.data.role in ['customer', 'vendor'];
      allow update: if signedIn() && request.auth.uid == userId
          && request.resource.data.role == resource.data.role;

      match /savedLocations/{locationId} {
        allow read, delete: if ownsCustomer(userId);
        allow create, update: if ownsCustomer(userId)
            && validSavedLocation(request.resource.data, locationId);
      }

      match /savedSearches/{searchId} {
        allow read, delete: if ownsCustomer(userId);
        allow create, update: if ownsCustomer(userId)
            && searchId.size() <= 1400
            && validSavedSearch(request.resource.data);
      }

      match /dishFollows/{followId} {
        // Owner path checks also permit a transaction to read a missing
        // subscription before its first follow, and permit owner list queries.
        allow read, delete: if ownsCustomer(userId);
        allow create: if ownsCustomer(userId)
            && validDishFollow(request.resource.data, userId, followId)
            && request.resource.data.followedAt == request.time
            && exists(/databases/$(database)/documents/vendors/$(request.resource.data.vendorId))
            && exists(/databases/$(database)/documents/vendors/$(request.resource.data.vendorId)/menu/$(request.resource.data.itemId));
        allow update: if ownsCustomer(userId)
            && validDishFollow(request.resource.data, userId, followId)
            && request.resource.data == resource.data;
      }

      match /notifications/{notificationId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow update: if signedIn() && request.auth.uid == userId
            && request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly(['isRead'])
            && request.resource.data.isRead == true;
        allow delete: if signedIn() && request.auth.uid == userId;
        allow create: if false;
      }

      match /searchHistory/{searchId} {
        allow read: if verifiedAccount() && request.auth.uid == userId;
        allow create, update: if verifiedAccount()
            && request.auth.uid == userId
            && validSearchHistory(request.resource.data);
        allow delete: if verifiedAccount() && request.auth.uid == userId;
      }
    }

    match /follows/{followId} {
      allow read: if request.auth != null
          && request.auth.uid == resource.data.customerId;
      allow create: if verifiedAccount()
          && request.auth.uid == request.resource.data.customerId;
      allow delete: if request.auth != null
          && request.auth.uid == resource.data.customerId;
    }
  }
}
